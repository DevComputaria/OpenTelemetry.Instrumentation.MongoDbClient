<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>DevComputaria</Authors>
    <Company>DevComputaria</Company>
    <Copyright>Copyright 2026 DevComputaria</Copyright>
    <PackageTags>OpenTelemetry;Instrumentation;MongoDB</PackageTags>
    <MinVerTagPrefix>Instrumentation.MongoDbClient-</MinVerTagPrefix>
  </PropertyGroup>
</Project>
