<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)../../build/Common.props" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <Description>Auto-instrumentation for MongoDB.Driver.Core that provides distributed tracing spans and metrics for MongoDB client operations using OpenTelemetry. Captures commands (find, insert, update, delete, etc.), database and collection names, and operation durations. Supports filtering, enrichment, and exception recording.</Description>
    <PackageTags>$(PackageTags);MongoDbClient;Tracing;Metrics;APM;Observability</PackageTags>
    <Title>OpenTelemetry.Instrumentation.MongoDbClient</Title>
    <Copyright>Copyright 2026 DevComputaria</Copyright>
    <PackageProjectUrl>https://github.com/DevComputaria/OpenTelemetry.Instrumentation.MongoDbClient</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>https://github.com/DevComputaria/OpenTelemetry.Instrumentation.MongoDbClient/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <MinVerTagPrefix>Instrumentation.MongoDbClient-</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver.Core" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>
</Project>
